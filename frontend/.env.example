# Google Login Client ID (From Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Note: The following keys should ideally be in the backend, 
# but are included here if used for local dev/testing.
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
# Standard Google AI Key
GOOGLE_API_KEY=your_google_api_key_here

# Database (Turso)
TURSO_DB_URL=your_turso_db_url_here
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# LangSmith configuration
VITE_LANGCHAIN_TRACING_V2=true
VITE_LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
VITE_LANGCHAIN_API_KEY=your_langsmith_api_key_here
VITE_LANGCHAIN_PROJECT=TenderCheckAI
